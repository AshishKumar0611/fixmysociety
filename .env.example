# Copy this file to .env and adjust. Never commit .env.

# Database connection.
#   Local development (SQLite file, created by `npm run db:setup`):
DATABASE_URL="file:./dev.db"
#   Production (PostgreSQL, e.g. Neon/Supabase/Vercel Postgres) — use with prisma/postgres/schema.prisma:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
#   Direct (non-pooled) URL used for migrations in production (Vercel's Neon integration sets it):
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Load demo data during `npm run build:postgres` (idempotent). Production only.
# SEED_DEMO_DATA="false"

# One-click demo logins on the sign-in page. Leave "false" for real deployments.
# Setting "true" lets ANYONE open the fictional demo accounts (including a manager account).
DEMO_MODE="false"

# Password given to all seeded demo accounts. Required when seeding with NODE_ENV=production.
# Locally it defaults to Demo@2026 if unset.
SEED_DEMO_PASSWORD=""
